{
  "expo": {
    "name": "Tagebuch",
    "slug": "tagebuch",
    "scheme": "tagebuch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.github.almaz6380.tagebuch",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.github.almaz6380.tagebuch",
      "adaptiveIcon": {
        "backgroundColor": "#F5EFE3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "Tagebuch",
      "shortName": "Tagebuch",
      "themeColor": "#F5EFE3",
      "backgroundColor": "#F5EFE3"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5EFE3",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Tagebuch nutzt Face ID, um dein Tagebuch zu entsperren."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8C5A3C",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tagebuch braucht Zugriff auf deine Fotos, damit du Bilder zu Einträgen hinzufügen kannst.",
          "cameraPermission": "Tagebuch braucht die Kamera, damit du Fotos für deine Einträge aufnehmen kannst.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
