{
  "expo": {
    "name": "Journal",
    "slug": "tagebuch",
    "scheme": "tagebuch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.github.almaz6380.tagebuch",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "de"
        ],
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "io.github.almaz6380.tagebuch",
      "adaptiveIcon": {
        "backgroundColor": "#F5EFE3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "Journal",
      "shortName": "Journal",
      "themeColor": "#F5EFE3",
      "backgroundColor": "#F5EFE3"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5EFE3",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Journal uses Face ID to unlock your journal."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8C5A3C",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Journal needs access to your photos so you can add pictures to your entries.",
          "cameraPermission": "Journal needs the camera so you can take photos for your entries.",
          "microphonePermission": false
        }
      ],
      "./plugins/withReleaseSigning",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "en": "./locales/en.json",
      "de": "./locales/de.json"
    }
  }
}
